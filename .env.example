# Copy to .env and fill in. Blank values count as unset.
# README.md > Configuration says what each setting means and where to find its value.
# Quote any value that contains #, which otherwise starts a comment.

# --- Discord -----------------------------------------------------------------
DISCORD_TOKEN=
# The one server the bot watches.
GUILD_ID=
# shadow | delete | kick | ban
MODE=shadow
# Where alerts go. Required in shadow mode; recommended in every mode.
MOD_CHANNEL_ID=
# Pinged in shadow mode and whenever an action fails (at most once per author per 10 minutes).
MOD_ROLE_ID=

# --- Judging -----------------------------------------------------------------
# Act when P(spam) + P(scam) is at least this.
FLAG_THRESHOLD=0.8
# Comma-separated IDs that are never judged.
EXEMPT_ROLE_IDS=
EXEMPT_CHANNEL_IDS=
# Skip members who can already moderate. Set false to test the bot on your own messages.
EXEMPT_STAFF=true
# Free text the model reads with every message, e.g. "Self-promotion is allowed in #showcase."
SERVER_CONTEXT=
# Earlier messages in the channel to include as context (0 to 20). These are other members'
# messages, sent to Liquid AI.
CHANNEL_CONTEXT_MESSAGES=5
# Send image attachments to the model too (d1 accepts JPEG, PNG, WebP and GIF).
CLASSIFY_IMAGES=false
# Model calls in flight at once; the rest queue.
MAX_CONCURRENCY=4
# SQLite file for messages moderators mark with "Mark as spam", "Mark as scam" or "Mark as not spam".
DATABASE_PATH=data/liquidy.db
# debug | info | warn | error. debug also logs every message the bot skips, and why.
LOG_LEVEL=info

# --- Model -------------------------------------------------------------------
# Liquid AI's System One decision API. d1, or d1-ultra (more capable, costs more).
MODEL=d1
MODEL_TIMEOUT_MS=10000

# Keys start with liquid_ (console.liquid.ai > Dashboard > API Keys).
LIQUID_API_KEY=
# Change to point at anything else that serves /decisions/v1/systemone.
LIQUID_BASE_URL=https://api.liquid.ai
