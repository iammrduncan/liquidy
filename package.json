{
  "name": "liquidy",
  "version": "0.1.0",
  "private": true,
  "description": "A Discord bot that judges every message with Liquid AI's d1 decision model and acts on spam and scams.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning dist/index.js",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/index.ts",
    "classify": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/classify.ts",
    "export": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/export.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
